# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-render-domain.onrender.com,localhost

# PostgreSQL — use a full DATABASE_URL (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS / CSRF — set to your frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://personal-website-nwbx.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://personal-website-nwbx.vercel.app

# ── Chatbot ────────────────────────────────────────────────────────────────────
# Groq (https://console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Hugging Face Inference API (https://huggingface.co/settings/tokens)
HF_API_TOKEN=your-hf-token

# Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=resume_chunks

# Cron protection — random secret shared with cron-job.org
CRON_SECRET=generate-a-long-random-string-here

# Visitor hashing — never stored raw; used only to hash client IPs
VISITOR_HASH_SECRET=generate-another-long-random-string-here

# Rate limiting (optional — these are the defaults)
CHAT_RATE_LIMIT_DAILY=15
CHAT_RATE_LIMIT_BURST=5

# Response cache TTL in seconds (optional — default 3600)
RESPONSE_CACHE_TTL=3600
